# Runtime environment
APP_ENV=development

# PostgreSQL connection
POS_DB_HOST=localhost
POS_DB_PORT=5432
POS_DB_NAME=mchange_me
POS_DB_USER=change_me
POS_DB_PASSWORD=change_me

# Frankfurter API configuration
API_URL=https://api.frankfurter.dev/v2/rates
START_DATE=2025-01-01
END_DATE=2026-12-31

# Target currencies (excluding USD which is the base)
TARGET_CURRENCIES=COP,PEN,BOB,CLP
